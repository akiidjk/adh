# General configuration
LOG_LEVEL=info

# Application configuration
DASHBOARD_PORT=3000
WEBHOOK_PORT=8080
WEBHOOK_PUBLIC_URL=http://localhost:8080
SECRET_KEY=replace_with_at_least_32_random_characters

# Set only when requests arrive through a trusted reverse proxy.
TRUST_PROXY=false

# Redis configuration
REDIS_ADDR=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# Frontend configuration
USER_ID=0
USER_NAME=username
USER_PASSWORD=your_password_here
